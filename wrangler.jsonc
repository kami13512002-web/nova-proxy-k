{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-k",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "335e46ac-576d-49d7-a1de-02e0f592f93c","database_name": "kami1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "cc0cb87ae0ee48c0af7d152f963e6ab4" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
